Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /LiDAR1 Front1
        - /LiDAR2 Rear raw1
        - /LiDAR2 Aligned1
        - /Merged Cloud1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Line Style:
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true

    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 100; 100
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: LiDAR1 Front
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /point_cloud
      Use Fixed Frame: true
      Value: true

    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 100; 100; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: LiDAR2 Rear raw
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /point_cloud2
      Use Fixed Frame: false
      Value: true

    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 100; 255; 100
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: LiDAR2 Aligned
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lidar_calib/aligned_cloud
      Use Fixed Frame: true
      Value: true

    - Alpha: 0.8
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: false
      Name: Merged Cloud
      Size (Pixels): 1
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lidar_calib/merged_cloud
      Use Fixed Frame: true
      Value: true

    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true

  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: sim_lidar
    Frame Rate: 30

  Name: root

  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30
      Focal Point: {X: 0, Y: 0, Z: 0}
      Name: Current View
      Pitch: 0.8
      Target Frame: <Fixed Frame>
      Yaw: 3.14
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Views:
    collapsed: false
  Width: 1600
  X: 0
  Y: 0
